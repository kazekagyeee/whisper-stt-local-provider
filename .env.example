# Server config
PORT=8000
HOST=0.0.0.0

# Whisper model settings
# Options: tiny, base, small, medium, large-v3
# tiny/base = fast CPU inference
# small/medium/large-v3 = better quality, may need GPU
WHISPER_MODEL=base

# Language for transcription (None = auto-detect)
WHISPER_LANGUAGE=ru

# Compute type: auto, float16, int8, float32
# auto = uses float16 on GPU, int8 on CPU
# float16 = requires CUDA
# int8 = slower but uses less RAM
WHISPER_COMPUTE_TYPE=auto

# Device: auto, cpu, cuda
# auto = uses CUDA if available, otherwise CPU
WHISPER_DEVICE=auto

# Optional: custom model cache directory
# MODEL_CACHE_DIR=/path/to/cache
